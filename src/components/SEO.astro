---
import { site } from '../data/site';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  /**
   * Keep the page out of the index but KEEP crawling its outbound links, so the
   * internal links on it still pass signal to the pages we do want ranking.
   * Used by the 200+ showroom product detail pages: they are near-duplicate,
   * zero-search-demand SKU stubs that drag site-wide quality, but they link up
   * into /services/{product}/ which we very much want crawled.
   */
  noindexFollow?: boolean;
}

const { title, description, canonical, image = '/images/brand/floors-to-you-okc-og.webp', type = 'website', noindex = false, noindexFollow = false } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.domain).toString();
const imageUrl = new URL(image, site.domain).toString();

// Titles longer than ~60 characters get cut in the SERP, and the part that gets
// cut is the brand — which is the least useful part. Drop the trailing brand
// segment ourselves so the descriptive, keyword-carrying half always survives.
function fitTitle(t, max = 60) {
  const text = String(t ?? '').trim().replace(/\s+/g, ' ');
  if (text.length <= max) return text;
  const m = text.match(/^(.*?)(\s+[|·–-]\s+[^|·–]+)$/);
  if (m && m[1].trim().length >= 30) {
    const head = m[1].trim();
    return head.length <= max ? head : fitTitle(head, max);
  }
  return text;
}
---
<title>{fitTitle(title)}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
{!noindex && noindexFollow && <meta name="robots" content="noindex,follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fitTitle(title)} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fitTitle(title)} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<meta name="geo.region" content="US-OK" />
<meta name="geo.placename" content="Oklahoma City" />
<meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
<meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
