---
/**
 * /book — paid-traffic funnel landing page (FB / Meta).
 * Layout follows the TFPros /book funnel (house funnel template):
 * scrolling strip -> headline + FORM (in view on land) -> weekly-openings timer ->
 * real reviews -> facts -> what happens next -> financing -> quick answers -> final CTA.
 * Only claims that appear on the main site (price-match guarantee, next-day install,
 * 100% product & labor guarantee, 0% APR / 24 mo via Synchrony, since 2018).
 * noindex comes from FunnelLayout. Pixel + tw_attrib attribution also live there.
 */
import FunnelLayout from '../layouts/FunnelLayout.astro';
import ReviewCards from '../components/ReviewCards.astro';
import { site } from '../data/site';

const title = 'Free In-Home Flooring Estimate · Floors To You OKC';
const description = `Tell us about your flooring project. Free in-home estimate across the OKC metro - we bring the showroom to you. Lowest price guaranteed, next-day install on in-stock material.`;
const TZ = 'America/Chicago';

const strip = [
  'Lowest price guaranteed · We beat any written quote',
  'Free in-home estimates across the OKC metro',
  'We bring the showroom to you',
  'Next-day install on in-stock material',
  '100% product & labor guarantee',
  '0% APR financing for 24 months',
  'Locally owned since 2018',
];
---
<FunnelLayout title={title} description={description} strip={strip}>

  {/* HERO — headline + subhead, then the form (in view on land, mobile + desktop) */}
  <section class="relative isolate overflow-hidden bg-gradient-to-br from-cream via-brand-50 to-cream">
    <div class="absolute -top-32 -right-32 -z-10 h-[36rem] w-[36rem] rounded-full bg-brand-300/30 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-32 -left-32 -z-10 h-[28rem] w-[28rem] rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="mx-auto w-full max-w-6xl px-4 sm:px-5 pt-3 pb-10 lg:pt-14 lg:pb-20">
      <div class="grid lg:grid-cols-[1fr_480px] gap-4 lg:gap-14 items-start">
        <div class="lg:pt-6 text-center lg:text-left">
          <h1 class="font-display font-bold tracking-tight text-brand-800 text-[1.55rem] leading-[1.12] sm:text-4xl lg:text-5xl">
            We'd love to talk to you about <span class="text-brand-500">your project.</span>
          </h1>
          <p class="mt-2 lg:mt-5 text-[0.93rem] sm:text-lg text-ink/75 leading-snug lg:leading-relaxed max-w-xl mx-auto lg:mx-0">
            Submit your info and someone will reach out to you regarding your project and your vision.
          </p>
          <ul class="hidden lg:grid mt-7 gap-2.5 list-none p-0">
            {[
              'Free in-home estimate - we bring the showroom to you',
              'Lowest price guaranteed - we beat any written quote',
              'Next-day install on in-stock material',
              '100% product & labor guarantee',
            ].map((v) => (
              <li class="flex items-center gap-2.5 text-base text-ink/85">
                <svg class="w-5 h-5 flex-none text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>{v}</span>
              </li>
            ))}
          </ul>
        </div>

        <div id="form" class="scroll-mt-20">
          <div class="rounded-xl2 bg-white ring-1 ring-brand-200 shadow-soft overflow-hidden">
            <div class="bg-gradient-to-r from-brand-700 to-brand-500 px-5 py-2.5">
              <div class="text-[0.65rem] uppercase tracking-[0.2em] font-bold text-white/85">Free · No obligation</div>
              <div class="font-display text-lg font-bold text-white leading-tight">Tell us about your project</div>
            </div>
            <iframe
              src="https://api.leadconnectorhq.com/widget/survey/vycAfKp5EIUhWwIGzbbc"
              scrolling="no"
              id="vycAfKp5EIUhWwIGzbbc"
              title="Book a free in-home flooring estimate"
              loading="eager"
              fetchpriority="high"
              class="fty-survey-frame"
              style="border:0;width:100%;height:469px;display:block;background:transparent;"
            ></iframe>
          </div>
          <p class="mt-3 text-center text-[11px] sm:text-xs text-ink/55 leading-relaxed">
            By submitting, you agree to be contacted by Floors To You OKC. We never share your info.
          </p>
        </div>
      </div>
    </div>

    {/* Form embed script + post-submit redirect. */}
    <script src="https://link.msgsndr.com/js/form_embed.js" is:inline async></script>
    <script is:inline>
      const FTY_BOOK_REDIRECT = '/book-estimate';
      let ftyRedirected = false;
      window.addEventListener('message', (e) => {
        if (!e.origin || !/leadconnectorhq\.com|msgsndr\.com/.test(e.origin)) return;
        const d = e.data;
        const submitted =
          (typeof d === 'string' && /submit/i.test(d)) ||
          (d && (d.type === 'form_submit_redirect' || d.type === 'survey_submit_redirect' || d.type === 'form_submit_action' || /submit/i.test(d.event || d.type || '')));
        if (submitted && !ftyRedirected) {
          ftyRedirected = true;
          window.top.location.href = FTY_BOOK_REDIRECT;
        }
      });
    </script>
  </section>

  {/* WEEKLY OPENINGS — resets every Sunday at midnight, Oklahoma City time */}
  <section class="relative isolate overflow-hidden text-white">
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-900 via-brand-800 to-brand-900"></div>
    <div class="mx-auto max-w-6xl px-5 py-10 lg:py-14 flex flex-col lg:flex-row items-center justify-between gap-7">
      <div class="text-center lg:text-left">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 ring-1 ring-white/20 px-3 py-1 text-[0.65rem] uppercase tracking-[0.2em] font-bold">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-400 animate-pulse"></span>
          Limited openings
        </span>
        <h2 class="mt-3 text-white font-display text-3xl sm:text-4xl font-bold leading-tight">This week's estimate openings</h2>
        <p class="mt-2 text-white/75">The schedule for this week closes when the timer hits zero.</p>
      </div>
      <div class="flex gap-2.5 sm:gap-3" data-countdown data-tz={TZ} role="timer" aria-label="Time left to book this week">
        {[['d', 'Days'], ['h', 'Hrs'], ['m', 'Min'], ['s', 'Sec']].map(([k, label]) => (
          <div class="cd-seg">
            <span data-cd={k}>--</span>
            <small>{label}</small>
          </div>
        ))}
      </div>
    </div>
    <div class="pb-10 text-center">
      <a href="#form" class="inline-flex items-center gap-2 rounded-xl2 bg-brand-500 hover:bg-brand-600 px-7 py-3.5 font-bold text-sm uppercase tracking-wider text-white no-underline">
        Grab a spot this week
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  {/* SOCIAL PROOF — real Google reviews (src/data/testimonials.ts), no invented counts */}
  <section class="bg-white py-14 lg:py-20">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto">
        <div class="text-brand-500 tracking-[0.2em] text-lg" aria-hidden="true">★★★★★</div>
        <h2 class="mt-2 font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-800 leading-tight">What OKC homeowners say.</h2>
        <p class="mt-2 text-sm text-ink/60">Real Google reviews</p>
      </div>
      <ReviewCards class="mt-10 max-w-5xl mx-auto" />
      <div class="mt-8 text-center">
        <a href="#form" class="inline-flex items-center gap-2 rounded-xl2 bg-brand-500 hover:bg-brand-600 px-6 py-3 font-semibold text-white text-sm no-underline">Tell us about your project</a>
      </div>
    </div>
  </section>

  {/* FACTS BAND — only what the main site states */}
  <section class="bg-brand-900 text-white py-12 lg:py-16">
    <ul class="mx-auto max-w-6xl px-5 grid grid-cols-2 lg:grid-cols-4 gap-y-8 gap-x-6 text-center list-none p-0">
      {[
        { v: '2018', label: 'Serving the OKC metro since' },
        { v: '100%', label: 'Product & labor guarantee' },
        { v: 'Next-day', label: 'Install on in-stock material' },
        { v: `${site.serviceRadiusMiles} mi`, label: 'Service radius from our showroom' },
      ].map((s) => (
        <li>
          <div class="font-display text-4xl sm:text-5xl font-bold text-brand-400 leading-none">{s.v}</div>
          <div class="mt-3 text-[11px] uppercase tracking-[0.22em] text-white/70 font-semibold">{s.label}</div>
        </li>
      ))}
    </ul>
  </section>

  {/* WHAT HAPPENS NEXT */}
  <section class="bg-cream py-14 lg:py-20">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-center font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-800 leading-tight">What happens next.</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3 list-none p-0">
        {[
          { n: '01', t: 'We reach out', b: 'Someone from our team contacts you to talk through your project and your vision.' },
          { n: '02', t: 'We bring the showroom to you', b: 'Samples come to your home so you can see them in your own light. We measure while we are there.' },
          { n: '03', t: 'Itemized written quote', b: 'Honest pricing in writing. In-stock material can be installed as soon as the next day.' },
        ].map((s) => (
          <li class="rounded-xl2 bg-white ring-1 ring-brand-100 shadow-card p-7">
            <div class="font-display text-3xl font-bold text-brand-500">{s.n}</div>
            <h3 class="mt-2 font-display text-lg font-bold text-brand-800">{s.t}</h3>
            <p class="mt-2 text-sm text-ink/75 leading-relaxed">{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* FINANCING — advertised on the main site (/financing, Synchrony) */}
  <section class="relative isolate overflow-hidden text-white">
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-800 via-brand-700 to-brand-800"></div>
    <div class="container-x py-12 lg:py-16 text-center max-w-3xl mx-auto">
      <p class="text-[11px] sm:text-xs uppercase tracking-[0.28em] text-brand-200 font-bold mb-3">Financing through Synchrony</p>
      <h2 class="text-white font-display text-3xl sm:text-4xl font-bold leading-tight">0% APR for 24 months.</h2>
      <p class="mt-4 text-white/85 text-base sm:text-lg max-w-xl mx-auto">
        Qualifying projects can be financed at 0% interest for 24 months, with quick online approval. Larger projects can be financed up to 60 months at low fixed rates.
      </p>
      <a href="#form" class="mt-7 inline-flex items-center gap-2 rounded-xl2 bg-white text-brand-800 hover:bg-brand-50 px-7 py-3.5 font-bold text-sm uppercase tracking-wider no-underline">Ask about financing</a>
    </div>
  </section>

  {/* QUICK ANSWERS — from src/data/faqs.ts + site promises */}
  <section class="bg-white py-14 lg:py-20">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-center font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-800 leading-tight">Quick answers.</h2>
      <ul class="mt-10 divide-y divide-brand-100 ring-1 ring-brand-100 rounded-xl2 bg-cream overflow-hidden list-none p-0">
        {[
          { q: 'Is the in-home estimate free?', a: 'Yes. Free in-home flooring estimates throughout the OKC metro. We bring the samples to you.' },
          { q: 'How fast can you install?', a: 'Most in-stock carpet, LVP and laminate installs can be scheduled within 24-72 hours of your accepted quote. Hardwood, tile and special-order materials take 5-10 business days.' },
          { q: 'What is the lowest price guarantee?', a: 'Bring a written quote on the same or comparable material and we will beat it.' },
          { q: 'What areas do you serve?', a: 'The entire Oklahoma City metro - including Edmond, Yukon, Mustang, Midwest City, Del City, Moore, Norman, Guthrie, Bethany and Piedmont - within 50 miles of our West Reno showroom.' },
        ].map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none">
                <span class="font-display font-semibold text-base text-brand-800">{f.q}</span>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand-500 transition-transform group-open:rotate-180 flex-none"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p class="px-6 pb-5 -mt-1 text-sm text-ink/75 leading-relaxed">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* FINAL CTA */}
  <section class="relative isolate overflow-hidden text-white">
    <div class="absolute inset-0 -z-10 bg-brand-900"></div>
    <div class="absolute -top-32 -right-32 -z-10 h-[28rem] w-[28rem] rounded-full bg-brand-500/25 blur-3xl"></div>
    <div class="container-x py-16 lg:py-24 text-center max-w-3xl mx-auto">
      <h2 class="text-white font-display text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">Let's talk about your floors.</h2>
      <a href="#form" class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl2 bg-brand-500 hover:bg-brand-600 text-white text-base font-bold uppercase tracking-wider px-8 py-4 shadow-soft no-underline">Tell us about your project</a>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[11px] uppercase tracking-[0.2em] text-white/60 font-semibold">
        <span>Locally Owned</span><span class="opacity-30">·</span>
        <span>100% Guarantee</span><span class="opacity-30">·</span>
        <span>Next-Day Install</span><span class="opacity-30">·</span>
        <span>0% APR · 24mo</span>
      </div>
    </div>
  </section>

  {/* Weekly openings countdown: counts to next Monday 00:00 in the client's time zone,
      so everyone sees the same clock and it resets every Sunday at midnight. */}
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-countdown]');
      if (!root) return;
      var tz = root.getAttribute('data-tz');
      var cells = {};
      ['d', 'h', 'm', 's'].forEach(function (k) { cells[k] = root.querySelector('[data-cd="' + k + '"]'); });
      var fmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: 'numeric', minute: 'numeric', second: 'numeric', hourCycle: 'h23' });
      var DOW = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };
      function pad(n) { return n < 10 ? '0' + n : String(n); }
      function tick() {
        var p = {};
        fmt.formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
        var intoDay = (+p.hour) * 3600 + (+p.minute) * 60 + (+p.second);
        var left = (8 - DOW[p.weekday]) * 86400 - intoDay;
        cells.d.textContent = pad(Math.floor(left / 86400));
        cells.h.textContent = pad(Math.floor((left % 86400) / 3600));
        cells.m.textContent = pad(Math.floor((left % 3600) / 60));
        cells.s.textContent = pad(left % 60);
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>

  <style>
    .cd-seg {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(212, 166, 83, 0.4);
      border-radius: 12px;
      padding: 0.7rem 0.4rem;
      min-width: 66px;
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 1;
    }
    .cd-seg > span { font-size: 2rem; font-weight: 800; font-variant-numeric: tabular-nums; }
    .cd-seg small { margin-top: 0.35rem; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.7; }
    @media (min-width: 720px) {
      .cd-seg { min-width: 88px; padding: 1rem 0.5rem; }
      .cd-seg > span { font-size: 2.75rem; }
    }
  </style>
</FunnelLayout>
